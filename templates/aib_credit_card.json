{
  "id": "aib_credit_card",
  "name": "AIB Credit Card Statement",
  "document_type": "credit_card_statement",
  "enabled": true,
  "detection": {
    "document_identifiers": {
      "card_number_patterns": [
        "\\*{4}\\s*\\*{4}\\s*\\*{4}\\s*[0-9]{4}",
        "[0-9]{4}\\s+[0-9]{2}\\*{2}\\s+\\*{4}\\s+[0-9]{4}"
      ]
    },
    "header_keywords": [
      "Click Visa Credit Card",
      "Credit Card",
      "AIB Credit Card"
    ],
    "exclude_keywords": [
      "IBAN",
      "Personal Bank Account",
      "Statement of Account"
    ],
    "column_headers": [
      "Date",
      "ReferenceNumber"
    ]
  },
  "extraction": {
    "table_top_y": 185,
    "table_bottom_y": 720,
    "enable_header_check": true,
    "header_check_top_y": 185,
    "columns": {
      "Transaction Date": [26, 78],
      "Posting Date": [78, 118],
      "Transaction Details": [118, 365],
      "Amount": [365, 430]
    }
  },
  "column_aliases": {
    "Transaction Date": "Date",
    "Transaction Details": "Details",
    "Amount": "Debit"
  },
  "processing": {
    "supports_multiline": true,
    "date_format": "%d %b %Y",
    "currency_symbol": "€",
    "decimal_separator": "."
  }
}
